<?xml version="1.0" encoding="UTF-8"?>
<!-- Artifact Bridge — dockable CEP panel for After Effects 2026 (CEP/CSXS 12).
     Node is enabled (mixed context) so the panel can require() the repo's pipeline
     modules and spawn node/claude as child processes. Unsigned: requires
     PlayerDebugMode=1 (set by install-panel.sh). -->
<ExtensionManifest Version="12.0" ExtensionBundleId="com.creo.aereplica"
  ExtensionBundleVersion="1.0.0" ExtensionBundleName="Artifact Bridge"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.creo.aereplica.panel" Version="1.0.0" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <!-- AEFT = After Effects. 22.0+ keeps it working across recent versions incl. 26 (2026). -->
      <Host Name="AEFT" Version="[22.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="12.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.creo.aereplica.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./host/host.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
            <Parameter>--allow-file-access</Parameter>
            <Parameter>--allow-file-access-from-files</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Artifact Bridge</Menu>
          <Geometry>
            <Size>
              <Height>700</Height>
              <Width>460</Width>
            </Size>
            <MinSize>
              <Height>360</Height>
              <Width>320</Width>
            </MinSize>
          </Geometry>
          <Icons />
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
